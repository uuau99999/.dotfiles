#!/usr/bin/env bash
#
# Pick one or more Herdr workspaces with fzf and close them. Mirrors tmux-clear
# for Herdr workspaces.

set -euo pipefail

for dep in fzf herdr jq; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    echo "herdr-clear: '$dep' not found in PATH" >&2
    exit 127
  fi
done

workspaces_json="$(herdr workspace list 2>/dev/null)" || exit 0

workspace_rows="$(
  jq -r '
    (.result.workspaces // [])
    | map(select((.workspace_id // .id // "") != ""))
    | .[]
    | [
        (.workspace_id // .id),
        (.label // .name // .title // .cwd // "workspace"),
        (.cwd // ""),
        (if .focused == true then "*" else "" end)
      ]
    | @tsv
  ' <<<"$workspaces_json"
)"

[[ -n "$workspace_rows" ]] || exit 0

# Preview the representative pane's visible screen (same as herdr-fzf).
# Prefer focused pane, then first agent pane, then first pane in the workspace.
preview='
workspace_id="$(printf "%s" {} | cut -f1)"
pane_id="$(
  herdr pane list --workspace "$workspace_id" 2>/dev/null | jq -r "
    (.result.panes // []) as \$p
    | (\$p | map(select(.focused == true))[0].pane_id)
      // (\$p | map(select(.agent != null))[0].pane_id)
      // \$p[0].pane_id
      // empty
  "
)"
[[ -n "$pane_id" ]] || exit 0
herdr pane read "$pane_id" --source visible --lines 50 2>/dev/null
'

selected="$(
  printf '%s\n' "$workspace_rows" |
    fzf \
      -m \
      --prompt='close herdr workspace> ' \
      --delimiter=$'\t' \
      --with-nth='4,2,3' \
      --preview "$preview"
)" || exit 0

[[ -n "$selected" ]] || exit 0

while IFS= read -r row; do
  workspace_id="$(cut -f1 <<<"$row")"
  [[ -n "$workspace_id" ]] || continue
  herdr workspace close "$workspace_id" >/dev/null
  printf 'Workspace %s cleared\n' "$workspace_id"
done <<<"$selected"
