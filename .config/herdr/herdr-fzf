#!/usr/bin/env bash
#
# Pick an existing Herdr workspace with fzf and focus it. If Herdr is not
# running or has no workspaces yet, fall back to herdr-sessionizer to create one
# from the configured Git roots.

set -euo pipefail

sessionizer="${HERDR_SESSIONIZER:-$HOME/.config/herdr/herdr-sessionizer}"
history_file="${HERDR_WORKSPACE_HISTORY:-$HOME/.config/herdr/workspace-history.tsv}"

for dep in fzf herdr jq; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    echo "herdr-fzf: '$dep' not found in PATH" >&2
    exit 127
  fi
done

fallback_sessionizer() {
  if [[ -x "$sessionizer" ]]; then
    "$sessionizer"
  fi
}

record_workspace() {
  local id="$1"
  local name="$2"
  local cwd="$3"

  [[ -n "$id" ]] || return 0
  mkdir -p "$(dirname "$history_file")"
  printf '%s\t%s\t%s\t%s\n' \
    "$(date +%s)" \
    "${id//$'\t'/ }" \
    "${name//$'\t'/ }" \
    "${cwd//$'\t'/ }" >>"$history_file"
}

workspaces_json="$(herdr workspace list 2>/dev/null)" || {
  fallback_sessionizer
  exit 0
}

workspace_rows="$(
  history_json="$(
    if [[ -f "$history_file" ]]; then
      jq -Rn '
        reduce inputs as $line ({};
          ($line | split("\t")) as $parts
          | if ($parts | length) >= 2 and ($parts[1] != "") then
              .[$parts[1]] = ($parts[0] | tonumber? // 0)
            else
              .
            end
        )
      ' <"$history_file"
    else
      printf '{}'
    fi
  )"
  jq -r --argjson history "$history_json" '
    (.result.workspaces // [])
    | to_entries
    | map(select((.value.workspace_id // .value.id // "") != ""))
    | map({
        index: .key,
        id: (.value.workspace_id // .value.id),
        label: (.value.label // .value.name // .value.title // .value.cwd // "workspace"),
        cwd: (.value.cwd // ""),
        focused: (if .value.focused == true then "*" else "" end),
        last: ($history[(.value.workspace_id // .value.id)] // 0)
      })
    | sort_by((if .last == 0 then 1 else 0 end), -(.last), .index)
    | .[]
    | [.id, .label, .cwd, .focused]
    | @tsv
  ' <<<"$workspaces_json"
)"

if [[ -z "$workspace_rows" ]]; then
  fallback_sessionizer
  exit 0
fi

# Preview the representative pane's visible screen (herdr 0.8+ pane read).
# Prefer focused pane, then first agent pane, then first pane in the workspace.
preview='
workspace_id="$(printf "%s" {} | cut -f1)"
pane_id="$(
  herdr pane list --workspace "$workspace_id" 2>/dev/null | jq -r "
    (.result.panes // []) as \$p
    | (\$p | map(select(.focused == true))[0].pane_id)
      // (\$p | map(select(.agent != null))[0].pane_id)
      // \$p[0].pane_id
      // empty
  "
)"
[[ -n "$pane_id" ]] || exit 0
herdr pane read "$pane_id" --source visible --lines 50 2>/dev/null
'

selected="$(
  printf '%s\n' "$workspace_rows" |
    fzf \
      --prompt='herdr workspace> ' \
      --delimiter=$'\t' \
      --with-nth='4,2,3' \
      --preview "$preview"
)" || exit 0

workspace_id="$(cut -f1 <<<"$selected")"
workspace_label="$(cut -f2 <<<"$selected")"
workspace_cwd="$(cut -f3 <<<"$selected")"
[[ -n "$workspace_id" ]] || exit 0

herdr workspace focus "$workspace_id" >/dev/null
record_workspace "$workspace_id" "$workspace_label" "$workspace_cwd"
